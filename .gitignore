# Local backup of the old OT-Simulator git history
/.git-ot-simulator/

# PlatformIO
.pio/

# VS Code: share only the extension recommendations.
# c_cpp_properties.json / launch.json are regenerated by PlatformIO with absolute paths.
.vscode/*
!.vscode/extensions.json

# Old v1.2.3 compile-time settings with credentials (settings now live in flash)
/src/settings.h
/src/settings.operational
/src/settings.test

# Generated from web/index.html by tools/embed_web.py
/src/web_index.h

# OpenTherm captures from tools/ot_check.py
/captures/

# Firmware images and dumps outside .pio
*.bin
*.elf
*.map

# Python
__pycache__/
*.py[cod]
.venv/

# Editor / OS clutter
*~
*.swp
*.log
.DS_Store
Thumbs.db
desktop.ini
